-- Run this once in the Supabase SQL Editor after replacing both placeholder values.
-- The secret key must be a Supabase secret API key, never the publishable browser key.

create extension if not exists pg_cron with schema pg_catalog;
create extension if not exists pg_net with schema extensions;

select vault.create_secret(
  'https://YOUR_PROJECT_REF.supabase.co',
  'email_worker_project_url'
);

select vault.create_secret(
  'YOUR_SUPABASE_SECRET_KEY',
  'email_worker_secret_key'
);

select cron.unschedule(jobid)
from cron.job
where jobname = 'send-notification-emails';

select cron.schedule(
  'send-notification-emails',
  '* * * * *',
  $$
  select net.http_post(
    url := (
      select decrypted_secret
      from vault.decrypted_secrets
      where name = 'email_worker_project_url'
      order by created_at desc
      limit 1
    ) || '/functions/v1/send-notification-emails',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'apikey', (
        select decrypted_secret
        from vault.decrypted_secrets
        where name = 'email_worker_secret_key'
        order by created_at desc
        limit 1
      )
    ),
    body := '{}'::jsonb
  );
  $$
);
